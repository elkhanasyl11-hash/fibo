# Fibo configuration. Copy to .env (repository root) and adjust. Never commit .env.
# Every variable has the FIBO_ prefix. Paths below are relative to backend/ (where the API runs);
# docker-compose overrides the data paths for the containers.

# --- General -------------------------------------------------------------------------------
FIBO_ENV=dev                       # dev | prod | test
FIBO_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
# SQLite by default. For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/fibo
FIBO_DATABASE_URL=sqlite+aiosqlite:///../data/sqlite/fibo.db
FIBO_DATA_DIR=../data              # holds media/, chroma/, sqlite/
# JSON list of web origins allowed to call the API (the dashboard dev server).
FIBO_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- AI providers ----------------------------------------------------------------------------
FIBO_AI_MODE=mock                  # mock = deterministic offline fixtures, live = real APIs
FIBO_LLM_BASE_URL=                 # OpenAI-compatible base URL, e.g. https://api.openai.com/v1
FIBO_LLM_API_KEY=                  # server secret; required for interactive AI chat
FIBO_LLM_MODEL=set-in-env          # chat model with JSON output + tool calling
FIBO_LLM_VISION_MODEL=set-in-env   # multimodal model for photo comparison / panel OCR
FIBO_LLM_TIMEOUT_S=45              # timeout of every external AI call, seconds
FIBO_SPEECH_BACKEND=api            # api = Whisper-compatible HTTP API, local = faster-whisper
FIBO_LLM_REASONING_EFFORT=auto     # auto = provider default; or none|low|medium|high; off = temperature 0
FIBO_WHISPER_MODEL=set-in-env      # model name for the chosen speech backend
FIBO_FFMPEG_BINARY=ffmpeg          # audio conversion; without it OGG/WAV/MP3 still work (libsndfile)

# Interactive chat defaults to live API, independently of FIBO_AI_MODE.
# Offline calculations require mode=offline explicitly. Restart the backend after editing .env.
# GPT-6 Luna/Sol function calling via Chat Completions requires reasoning_effort=none.

# --- Auth between services -------------------------------------------------------------------
FIBO_BOT_SHARED_SECRET=change-me   # bot sends it as X-Fibo-Bot-Token; set a long random value
FIBO_DASHBOARD_API_KEY=            # dashboard sends it as X-Fibo-Api-Key; leave empty to disable (dev only)
FIBO_WEB_SESSION_SECRET=           # signs web sign-in tokens; empty = random per run (dev only), >= 24 chars in prod
FIBO_WEB_SESSION_HOURS=336         # how long a web sign-in lasts (14 days)
FIBO_TELEGRAM_BOT_USERNAME=        # bot username without @, for the t.me sign-up link (e.g. FiboRAG_bot)
FIBO_WEB_BASE_URL=http://localhost:5173  # dashboard address used in Telegram alerts
FIBO_RISK_RECOMPUTE_MINUTES=60     # periodic risk recompute of every machine; 0 = off

# --- Limits and model files ------------------------------------------------------------------
FIBO_MAX_UPLOAD_MB=20              # max size of one uploaded file
FIBO_AUDIO_Z_WARNING=2.0           # machine sound: z >= 2 -> warning
FIBO_AUDIO_Z_CRITICAL=3.0          # machine sound: z > 3 -> critical
FIBO_EMBEDDING_BACKEND=e5          # e5 = multilingual-e5-small (ONNX, downloaded once); hash = offline test vectors
FIBO_MODEL_CACHE_DIR=                # where AI models are downloaded; empty = <data dir>/models
FIBO_EMBEDDING_MODEL_REPO=intfloat/multilingual-e5-small   # Hugging Face repo of the ONNX model
FIBO_EMBEDDING_MODEL_FILE=onnx/model_qint8_avx512_vnni.onnx  # int8 ONNX export, 118 MB
FIBO_RAG_MIN_SIMILARITY=0.83       # manual chunks less similar than this are "not found"
FIBO_PHOTO_MIN_SHARPNESS=60        # photo: variance of Laplacian below this = blurry
FIBO_PHOTO_MIN_BRIGHTNESS=40       # photo: mean grey (0-255) below this = too dark
FIBO_PHOTO_MAX_BRIGHTNESS=225      # photo: mean grey above this = overexposed
FIBO_RISK_MODEL_DIR=./ml/artifacts # trained risk model; missing -> index-only mode

# --- Telegram bot (bot/ container) -----------------------------------------------------------
FIBO_TELEGRAM_BOT_TOKEN=           # from @BotFather; secret, never commit it
FIBO_API_URL=http://localhost:8000/api/v1   # backend address as seen from the bot
FIBO_API_TIMEOUT_S=30

# --- Docker Compose only -------------------------------------------------------------------
FIBO_PRELOAD_EMBEDDINGS=false      # true = bake the e5 model (~135 MB) into the backend image

# --- AI service (sidecar, ai/ + docker compose --profile ai) ---------------------------------
FIBO_AI_PROVIDER=builtin           # sidecar = use the AI service first, builtin modules as fallback; builtin = backend only
FIBO_AI_URL=http://ai:8001         # AI service address as seen from the backend container
FIBO_AI_TOKEN=                     # must equal AI_SERVICE_TOKEN of the AI service; empty = no auth header
FIBO_AI_TIMEOUT_S=3                # health probe timeout (request timeouts are per endpoint)
FIBO_AI_SHARED_DIR=/app/data/media # media folder as seen inside the AI container (same volume)
# Variables read by the AI service container itself (not by the backend):
AI_STUB_MODE=false                 # true = deterministic stub answers, no models / no OpenAI
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_VISION_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
OPENAI_API_KEY=                    # secret; set only in .env / secret manager, never commit
AI_SERVICE_TOKEN=                  # secret shared with FIBO_AI_TOKEN; required when FIBO_ENV=prod
