server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size 25m;

  location /api/ {
    proxy_pass ${FIBO_API_UPSTREAM};
    proxy_set_header Host $host;
    # Browser sessions authorize requests. Do not grant the public proxy an integration key.
    proxy_set_header X-Fibo-Api-Key "";
    proxy_read_timeout 120s;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
